 /// position object and raises an asserts if something wrong is detected.
 /// This is meant to be helpful when debugging.
 
+/// Portals v2 (brief §4.7, 2026-09-18): a linked portal square is a BODY to
+/// every line, whatever stands on it, and an EMPTY PAIR is a TUNNEL for
+/// riders - a rook's, bishop's or queen's line entering an empty portal whose
+/// twin is also empty comes out of the twin in the same direction and runs
+/// on, through another empty pair as well, each pair once per line. Stopping
+/// at the entry is the ordinary portal move (the piece ends on the twin, or
+/// swaps with whatever stands there); a half is neither body nor tunnel until
+/// it is linked. Every ray in the engine passes its occupancy through the
+/// bodies (attacks_from, moves_from, attackers_to, the check squares, the
+/// pin lines, SEE's x-rays) and attackers_to() adds the tunnel attackers, so
+/// legality, check, evasions and the transposition-table checks read one
+/// rule. The helpers:
+
+namespace {
+
+  // The twin of a portal square, with one extra pair (xa, xb) that is not in
+  // the table yet - the pair a linking cast is about to make
+  inline Square twin_of(const int8_t* table, Square s, Square xa, Square xb) {
+    return s == xa ? xb : s == xb ? xa : Square(table[s]);
+  }
+
+  inline int sign_of(int d) { return (d > 0) - (d < 0); }
+}
+
+
+/// Position::open_portals() lists the portal squares whose pair is OPEN - both
+/// squares empty in the given piece occupancy (real or virtual) - the squares
+/// a rider's line may pass through.
+
+Bitboard Position::open_portals(Bitboard occupied, Bitboard portals, Square xa, Square xb) const {
+
+  Bitboard open = 0;
+  for (Bitboard b = portals & ~occupied; b; )
+  {
+      Square s = pop_lsb(b);
+      if (!(occupied & twin_of(st->portalTwin, s, xa, xb)))
+          open |= s;
+  }
+  return open;
+}
+
+
+/// Position::portal_through() returns the squares a rider on s reaches BEYOND
+/// the open pairs its lines enter. A line stops at a portal square as at any
+/// body; when that square is open the line continues from its twin in the same
+/// direction until the next body, which is included (a piece to capture, a
+/// plugged portal to step into) - and when that body is an open portal of a
+/// pair this line has not used, the line runs on again. `bodies` is the piece
+/// occupancy with the portal squares in it, `open` the open portal squares
+/// (open_portals) of the same board. Only rook and bishop lines tunnel; a
+/// leaper's or stepper's landing on a portal is the ordinary portal move.
+
+Bitboard Position::portal_through(RiderType riders, Square s, Bitboard bodies, Bitboard open, Square xa, Square xb) const {
+
+  if (!open)
+      return 0;
+
+  Bitboard rays = 0;
+  if (riders & RIDER_ROOK_H) rays |= rider_attacks_bb<RIDER_ROOK_H>(s, bodies);
+  if (riders & RIDER_ROOK_V) rays |= rider_attacks_bb<RIDER_ROOK_V>(s, bodies);
+  if (riders & RIDER_BISHOP) rays |= rider_attacks_bb<RIDER_BISHOP>(s, bodies);
+
+  Bitboard result = 0;
+  for (Bitboard entries = rays & open; entries; )
+  {
+      Square entry = pop_lsb(entries);
+      const int df = sign_of(int(file_of(entry)) - int(file_of(s)));
+      const int dr = sign_of(int(rank_of(entry)) - int(rank_of(s)));
+      Bitboard used = 0; // each pair once per line
+      while (true)
+      {
+          Square exit = twin_of(st->portalTwin, entry, xa, xb);
+          used |= square_bb(entry) | exit;
+          int f = int(file_of(exit)) + df, r = int(rank_of(exit)) + dr;
+          bool again = false;
+          while (f >= int(FILE_A) && f <= int(max_file()) && r >= int(RANK_1) && r <= int(max_rank()))
+          {
+              Square sq = make_square(File(f), Rank(r));
+              result |= sq;
+              if (bodies & sq)
+              {
+                  if ((open & sq) && !(used & sq))
+                  {
+                      entry = sq;
+                      again = true;
+                  }
+                  break;
+              }
