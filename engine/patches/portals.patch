+  Square ksq = square<KING>(kingColor);
+  if (ksq == from)
+      ksq = q;
+  else if (ksq == q && swapped)
+      ksq = p;
+
+  Bitboard occupied = pieces() ^ from;
+  if (victim)
+      occupied ^= p;
+  occupied |= q;
+  if (swapped)
+      occupied |= p;
+
+  // Pieces that stay where they are, through the new occupancy
+  if (attackers_to(ksq, occupied, att) & ~(square_bb(from) | q | p))
+      return true;
