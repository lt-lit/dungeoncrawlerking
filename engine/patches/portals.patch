+bool Position::portal_attacks_king(Move m, Color kingColor) const {
+
+  assert(type_of(m) == PORTAL);
+
+  if (!count<KING>(kingColor))
+      return false;
+
+  Square from = from_sq(m);
+  Square p = to_sq(m);
+  Square q = portal_twin(p);
+  Piece mover = piece_on(from);
+  Piece victim = piece_on(p);
+  Piece swapped = q != from ? piece_on(q) : NO_PIECE;
+  Color att = ~kingColor;
