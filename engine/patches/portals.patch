+// The trailing portal field: "{c3-h8,d1-a9,e4w}" - pairs and half-open portals.
+// Squares must lie on the board and off both promotion zones, and no square may
+// appear twice.
+inline Validation check_portal_field(const std::string& field, const Variant* v) {
+    if (field.size() < 2 || field.front() != '{' || field.back() != '}')
+        return NOK;
+    std::string body = field.substr(1, field.size() - 2);
+    std::vector<Square> seen;
+    auto parse_square = [&](size_t& i) -> Square {
+        if (i >= body.size() || body[i] < 'a' || body[i] > 'a' + int(v->maxFile))
+            return SQ_NONE;
+        File f = File(body[i++] - 'a');
+        int r = 0, digits = 0;
+        while (i < body.size() && isdigit((unsigned char)body[i]) && digits < 2)
+        {
+            r = 10 * r + (body[i++] - '0');
+            ++digits;
+        }
+        if (r < 1 || r > int(v->maxRank) + 1)
+            return SQ_NONE;
+        return make_square(f, Rank(r - 1));
+    };
+    auto admit = [&](Square s) {
+        if (s == SQ_NONE || ((v->promotionRegion[WHITE] | v->promotionRegion[BLACK]) & s))
+            return false;
+        for (Square t : seen)
+            if (t == s)
+                return false;
+        seen.push_back(s);
+        return true;
+    };
+    size_t i = 0;
+    while (i < body.size())
+    {
+        if (body[i] == ',' || body[i] == ' ')
+        {
+            ++i;
+            continue;
+        }
+        Square a = parse_square(i);
+        if (!admit(a))
+            return NOK;
+        if (i < body.size() && body[i] == '-')
+        {
+            ++i;
+            if (!admit(parse_square(i)))
+                return NOK;
+        }
+        else if (i < body.size() && (body[i] == 'w' || body[i] == 'b'))
+            ++i;
+        else
+            return NOK;
+    }
+    return OK;
+}
