+/// Position::parse_portal_field() reads the FEN's trailing portal field, the
+/// text between the braces: entries separated by commas, a pair as "c3-h8",
+/// a half-open portal as "e4w" or "e4b". Entries that cannot stand - off the
+/// board, in either promotion zone, on a wall or crate, or on a square already
+/// taken by a portal - are dropped.
+
+void Position::parse_portal_field(const std::string& field) {
+
+  auto parse_square = [&](size_t& i) -> Square {
+      if (i >= field.size() || field[i] < 'a' || field[i] > 'a' + int(max_file()))
+          return SQ_NONE;
+      File f = File(field[i++] - 'a');
+      int r = 0, digits = 0;
+      while (i < field.size() && isdigit((unsigned char)field[i]) && digits < 2)
+      {
+          r = 10 * r + (field[i++] - '0');
+          ++digits;
+      }
+      if (r < 1 || r > int(max_rank()) + 1)
+          return SQ_NONE;
+      return make_square(f, Rank(r - 1));
+  };
+
+  auto can_hold = [&](Square s) {
+      return  s != SQ_NONE
+           && (board_bb() & s)
+           && !((promotion_zone(WHITE) | promotion_zone(BLACK)) & s)
+           && !(st->portalSquares & s)
+           && (!(pieces() & s) || piece_on(s) != NO_PIECE);
+  };
+
+  size_t i = 0;
+  while (i < field.size())
+  {
+      if (field[i] == ',' || field[i] == ' ')
+      {
+          ++i;
+          continue;
+      }
+      Square a = parse_square(i);
+      if (a == SQ_NONE)
+          break;
+      if (i < field.size() && field[i] == '-')
+      {
+          ++i;
+          Square b = parse_square(i);
+          if (b == SQ_NONE)
+              break;
+          if (a != b && can_hold(a) && can_hold(b))
+          {
+              st->portalSquares |= square_bb(a) | b;
+              st->portalTwin[a] = int8_t(b);
+              st->portalTwin[b] = int8_t(a);
+          }
+      }
+      else if (i < field.size() && (field[i] == 'w' || field[i] == 'b'))
+      {
+          Color c = field[i++] == 'w' ? WHITE : BLACK;
+          if (can_hold(a) && a != st->portalHalf[~c])
+              st->portalHalf[c] = a;
+      }
+      else
+          break;
+  }
+}
