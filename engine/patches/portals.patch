+  // The mover, from the twin square
+  if (color_of(mover) == att && (attacks_bb(att, type_of(mover), q, occupied) & ksq))
+      return true;
+
+  // The swapped piece, from the target square
+  if (swapped && color_of(swapped) == att && (attacks_bb(att, type_of(swapped), p, occupied) & ksq))
+      return true;
+
+  return false;
