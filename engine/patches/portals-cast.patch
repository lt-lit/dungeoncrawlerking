+// Portals v3 (the one-turn cast, 2026-09-19): an open half binds both sides -
+// its caster to the linking cast, the other side to a pass - until it is
+// linked or fizzles. `in_cast` is the movegen's question (never while in
+// check: a half is cast only out of check and moves nothing, so neither side
+// can be in check while one is open in play); `half_open` is the same without
+// the check test, for do_move, where the new state's checkers are not yet set.
+inline bool Position::half_open() const {
+  assert(var != nullptr);
+  return var->portalScroll != NO_PIECE_TYPE && (st->portalHalf[WHITE] != SQ_NONE || st->portalHalf[BLACK] != SQ_NONE);
+}
+
+inline bool Position::in_cast() const {
+  return half_open() && !checkers();
+}
