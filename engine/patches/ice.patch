+      Square end = fell ? SQ_NONE : landing != SQ_NONE ? landing : cur;
+      Piece swapped = NO_PIECE;
+      Square twin = SQ_NONE;
+      if (!fell && landing != SQ_NONE && (st->portalSquares & landing))
+      {
+          twin = portal_twin(landing);
+          swapped = (occ & twin) ? piece_at(twin) : NO_PIECE;
+          end = twin;
+      }
+      Piece after = fell ? NO_PIECE : promoted(pc, end, isMover ? slide_promotion(m) : NO_PIECE_TYPE);
