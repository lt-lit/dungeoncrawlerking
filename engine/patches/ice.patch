+          {
+              relocSq[j] = relocSq[nr - 1];
+              relocPc[j] = relocPc[--nr];
+              break;
+          }
+      if (s.from == ksq)
+          ksq = s.to;
+      if (s.to != SQ_NONE)
+      {
+          occ |= s.to;
+          moved |= s.to;
+          relocSq[nr] = s.to;
+          relocPc[nr++] = s.after;
+      }
