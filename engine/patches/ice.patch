+/// The piece as it stands on 'to' the moment it lands, before the slide: the
+/// move's own promotion applies there when 'to' is in the zone (a PROMOTION
+/// move onto ice), else at the square it stops on (slide_outcome).
+
+Piece Position::slide_mover_piece(Move m) const {
+
+  Piece pc = piece_on(from_sq(m));
+  PieceType promo = slide_promotion(m);
+  if (promo != NO_PIECE_TYPE && type_of(pc) == PAWN && (promotion_zone(color_of(pc)) & to_sq(m)))
+      return make_piece(color_of(pc), promo);
+  return pc;
+}
